{erl_opts, [debug_info]}.
{minimum_otp_vsn, "26"}.

{deps, [
    {enoise, {git, "https://github.com/mmzeeman/enoise.git", {branch, "master"}}}
]}.

{shell, [{apps, [noisegate]}]}.

{escript_name, noisegate_guests}.
{escript_main_app, noisegate}.
{escript_incl_apps, []}.
{escript_emu_args, "%%! -escript main\n"}.
