{erl_opts, [debug_info]}.

{deps, [
    {enoise, {git, "https://github.com/mmzeeman/enoise.git", {branch, "fix-easgcm-rekey-19"}}}
]}.

{shell, [{apps, [bouncer]}]}.

%% `rebar3 escriptize` builds _build/default/bin/bouncer_guests. The escript
%% only needs the bouncer modules (bouncer_keys, bouncer_guests): enoise is
%% deliberately not included. rebar3 would use the
%% main app name (`bouncer`) as the main module, so name bouncer_guests explicitly.
{escript_name, bouncer_guests}.
{escript_main_app, bouncer}.
{escript_incl_apps, []}.
{escript_emu_args, "%%! -escript main bouncer_guests\n"}.
