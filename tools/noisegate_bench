#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

./rebar3 compile >&2
mkdir -p _build/tools
erlc -o _build/tools tools/noisegate_bench.erl

exec erl -noshell -name "noisegate_bench_$$@127.0.0.1" \
    -pa "$ROOT/_build/tools" -pa "$ROOT"/_build/default/lib/*/ebin \
    -s noisegate_bench main -extra "$@"
